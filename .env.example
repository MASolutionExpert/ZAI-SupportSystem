# =============================================================================
# Support Desk — Environment configuration (TEMPLATE)
# =============================================================================
# This file is a template with SAFE PLACEHOLDERS only. It is committed to git.
#
#   * NEVER commit the real ".env" — it contains secrets.
#   * Production installs should NOT hand-edit secrets: run
#       ./scripts/supportdesk.sh install
#     which creates .env automatically, generates AUTH_SECRET and
#     APP_ENCRYPTION_KEY with cryptographically secure randomness (openssl),
#     and prompts for the initial Super Admin password.
#   * Local development: copy to .env and adjust:
#       cp .env.example .env
# =============================================================================

# --- Database -----------------------------------------------------------------
# Location of the SQLite database file (Phase 1). In Docker production this
# path lives on the named volume `supportdesk_db` mounted at /app/db.
# The Prisma schema is provider-portable to PostgreSQL later (see DATABASE.md).
# SQLite v1 (single node): connection_limit=1 serializes queries through one
# connection (required for the fair-distribution engine and interactive
# transactions — see DATABASE.md §4.1). PostgreSQL deployments drop the param.
DATABASE_URL=file:/app/db/supportdesk.db?connection_limit=1

# --- Security / secrets ---------------------------------------------------------
# REQUIRED. Session integrity secret (min 32 chars). Used for signing /
# protecting server-side session tokens.
#   Generate:  openssl rand -base64 48
# NOTE: `supportdesk install` generates this automatically.
AUTH_SECRET=

# REQUIRED-IN-PRACTICE (Phase 4). 32-byte base64 key for application-level
# encryption of customer national IDs (AES-256-GCM), the keyed-HMAC lookup
# index and portal session signing. When absent, AUTH_SECRET is the key
# material source (development convenience) — set a dedicated key in production.
#   Generate:  openssl rand -base64 32
# NOTE: `supportdesk install` generates this automatically.
APP_ENCRYPTION_KEY=

# --- URLs ------------------------------------------------------------------------
# OPTIONAL. Canonical public URL of this deployment (used for absolute links).
# Replace with your real domain once DNS is set up.
APP_URL=https://support.example.com

# OPTIONAL. Additional same-origin hosts accepted by the CSRF origin check —
# comma-separated list of hostnames or full URLs. Entries starting with a dot
# are suffix rules accepting every subdomain of that zone (e.g.
# ".space-z.ai" — preview panels get a new subdomain per session). Only
# needed when a reverse-proxy chain rewrites the Host header so the original
# client-facing origin no longer appears in x-forwarded-host / host
# (symptom: every mutation answers 403 ORIGIN_MISMATCH
# «درخواست بین‌دامنه‌ای مجاز نیست» for legitimate users while the site
# otherwise renders fine).
#   Example: APP_TRUSTED_ORIGINS=support.example.com,staging.example.com:8443,.space-z.ai
APP_TRUSTED_ORIGINS=

# --- First bootstrap (initial Super Admin) ----------------------------------------
# Username of the initial Super Admin account (created only if it does not
# exist yet).
SUPERADMIN_USERNAME=admin

# REQUIRED on first bootstrap. The app enforces: >= 12 characters including
# upper case, lower case and a digit. NEVER commit a real password. The app
# forces a password change on first login. `supportdesk install` prompts for
# this value securely (hidden input) and refuses weak passwords.
SUPERADMIN_PASSWORD=

# Idempotent bootstrap: creates roles/permissions and the Super Admin account
# ONLY if they are missing. Never overwrites or deletes existing data.
BOOTSTRAP_ON_STARTUP=true

# --- Session & login policy ---------------------------------------------------------
# Server-side session lifetime in hours (168 = 7 days).
SESSION_TTL_HOURS=168

# Account lockout after N failed login attempts...
LOGIN_MAX_ATTEMPTS=5

# ...for this many minutes (brute-force protection; handled inside the app).
LOGIN_LOCK_MINUTES=15

# --- File storage --------------------------------------------------------------------
# Root directory for uploaded/persistent files. In Docker production this is
# the named volume `supportdesk_storage` mounted at /app/storage.
STORAGE_DIR=/app/storage

# --- Cookies ---------------------------------------------------------------------------
# Leave EMPTY to auto-detect HTTPS via the `x-forwarded-proto` header sent by
# your reverse proxy (recommended for the Caddy/nginx setups in DEPLOYMENT.md).
# Set to `true` only to force `Secure` cookies unconditionally.
FORCE_SECURE_COOKIES=

# --- Migrations ---------------------------------------------------------------------------
# When true (default), the Docker entrypoint runs `prisma migrate deploy` on
# every start: safe and idempotent — applies PENDING versioned migrations only,
# never resets data. Set to false to run migrations manually.
MIGRATE_ON_STARTUP=true

# --- Version ----------------------------------------------------------------------------------
# OPTIONAL override of the application version string. Normally read from the
# VERSION file shipped with the release; leave empty.
APP_VERSION=

# =============================================================================
# Deployment-only settings (read by docker-compose.yml and supportdesk.sh,
# NOT by the application itself)
# =============================================================================
# Full image reference to deploy. Pin an explicit version — NEVER :latest:
#   SUPPORTDESK_IMAGE=ghcr.io/<org>/<repo>:0.1.0
# `supportdesk install` / `supportdesk update` keep this value in sync.
#SUPPORTDESK_IMAGE=

# Host port that publishes the app (the container always listens on 3000).
#APP_PORT=3000
