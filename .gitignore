# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# Support Desk runtime data (never commit secrets or data)
/db/*.db
/db/*.db-journal
/db/pgdata/
/storage/
/tool-results/
/upload/
/download/

# Support Desk deployment backups (contain secrets — never commit)
/backups/
# Rollback point written by `supportdesk update`
/.deploy-state

# Keep the env example in Git
!.env.example
# Sandbox/template artifacts that are not part of the product
/.zscripts/
/examples/
/mini-services/
/tests/
/Caddyfile
/db/*.db-shm
/db/*.db-wal
